{
	"name": "r2nova",
	"private": true,
	"version": "0.1.2",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"tauri": "tauri",
		"icon": "rsvg-convert -w 1024 -h 1024 app-icon.svg -o /tmp/r2nova-app-icon.png && pnpm tauri icon /tmp/r2nova-app-icon.png && cp src-tauri/icons/32x32.png public/icon.png && rm -rf src-tauri/icons/ios src-tauri/icons/android",
		"release:check": "node scripts/check-version-consistency.mjs"
	},
	"dependencies": {
		"@headless-tree/core": "^1.7.0",
		"@headless-tree/react": "^1.7.0",
		"@hookform/resolvers": "^5.2.2",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.13.24",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-log": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "~2.3.1",
		"@tauri-apps/plugin-store": "^2",
		"@tauri-apps/plugin-updater": "~2.10.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"i18next": "^26.0.3",
		"i18next-browser-languagedetector": "^8.2.1",
		"lucide-react": "^0.577.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.71.2",
		"react-i18next": "^17.0.2",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.2.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24.12.3",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"jsdom": "^26.1.0",
		"typescript": "~5.8.3",
		"vite": "^7.3.2",
		"vitest": "^3.2.4"
	}
}
