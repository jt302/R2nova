{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "R2nova",
	"version": "0.1.7",
	"identifier": "io.r2nova.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "R2nova",
				"width": 1280,
				"height": 800,
				"minWidth": 960,
				"minHeight": 600,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' ipc: http://ipc.localhost",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
				"img-src": "'self' asset: http://asset.localhost blob: data: https://*.r2.cloudflarestorage.com https://*.eu.r2.cloudflarestorage.com https://*.fedramp.r2.cloudflarestorage.com",
				"media-src": "'self' asset: http://asset.localhost blob: https://*.r2.cloudflarestorage.com https://*.eu.r2.cloudflarestorage.com https://*.fedramp.r2.cloudflarestorage.com",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"worker-src": "'self' blob:",
				"object-src": "'none'",
				"base-uri": "'self'",
				"frame-src": "'self' asset: http://asset.localhost blob: https://*.r2.cloudflarestorage.com https://*.eu.r2.cloudflarestorage.com https://*.fedramp.r2.cloudflarestorage.com"
			},
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPCACHE/**", "$APPDATA/avatars/**", "$APPDATA/development/avatars/**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["app", "dmg", "nsis", "deb", "rpm", "appimage"],
		"linux": {
			"appimage": {
				"bundleMediaFramework": true
			},
			"deb": {
				"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libdbus-1-3"]
			},
			"rpm": {
				"depends": ["webkit2gtk4.1", "gtk3", "dbus-libs"]
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "13.0",
			"hardenedRuntime": true
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NkFFODc4QTM4QzgxRjQKUldUMGdZeWplT2hxbER5Ri92MEMyWWxydWNuQzIyRXgxMWR0K0pIM0laR1l1RXR3UWpoNE1jNHUK",
			"endpoints": ["https://github.com/jt302/R2nova/releases/latest/download/latest.json"]
		}
	}
}
